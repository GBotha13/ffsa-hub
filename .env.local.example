# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CRM / Communications module
# Mailtrap "Email Sending" API token — marketing campaign sends
MAILTRAP_API_TOKEN=your-mailtrap-api-token
# HMAC secret for signed unsubscribe links (any long random string)
UNSUBSCRIBE_TOKEN_SECRET=your-long-random-secret
# Public base URL — used to build unsubscribe links in campaign emails
NEXT_PUBLIC_APP_URL=https://www.ffsahub.com
# Shared secret for the scheduled-send cron route (Vercel Cron Authorization)
CRON_SECRET=your-long-random-secret

# Anthropic API key — powers AI Polish + Suggest Layout in the campaign composer
# Get from https://console.anthropic.com/settings/keys
# Set in Vercel project env (all environments) so deployed previews/prod work
ANTHROPIC_API_KEY=your-anthropic-api-key

# Slack integration (Phase 1+)
# Bot OAuth token from https://api.slack.com/apps — your "FFSA Hub Activity" app
# Required scopes: chat:write, chat:write.public, im:write, users:read, users:read.email
# Set in Vercel project env (Production + Preview + Development)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Optional fallback for #ffsa-activity channel id (used until the admin
# integration page writes slack_settings.channel_id). Slack channel ids look like C0123ABCD.
SLACK_ACTIVITY_CHANNEL_ID=
